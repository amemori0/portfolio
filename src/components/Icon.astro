---
// サイト共通のアイコン。すべて 24×24 の線画(太さ2)にそろえる。GitHub のみロゴのため塗り
// 装飾として使うので aria-hidden。意味が必要な場合は、隣に文章か u-sr-only を置く
interface Props {
  name: "arrow-right" | "external" | "check" | "alert" | "spinner" | "github";
  size?: 16 | 20 | 24;
  class?: string;
  [attribute: `data-${string}`]: string;
}

const { name, size = 20, class: className, ...rest } = Astro.props;
---

<svg {...rest} class:list={["icon", className]} data-icon={name} aria-hidden="true" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === "check" && <path d="M20 6 9 17l-5-5" />}
  {
    name === "alert" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v6M12 16.5v.5" />
      </>
    )
  }
  {name === "spinner" && <path d="M21 12a9 9 0 1 1-9-9" />}
  {
    name === "github" && (
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.84c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85 0 1.34-.01 2.42-.01 2.75 0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z"
      />
    )
  }
</svg>

<style>
  .icon {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon[data-icon="spinner"] {
      animation: icon-spin 0.8s linear infinite;
    }
  }

  @keyframes icon-spin {
    to {
      rotate: 1turn;
    }
  }
</style>
