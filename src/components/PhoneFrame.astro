---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  loading?: "eager" | "lazy";
}

const { image, alt, sizes, loading = "lazy" } = Astro.props;
---

<div class="phone-frame">
  <div class="phone-frame__body">
    <div class="phone-frame__screen">
      <Image class="phone-frame__image" src={image} alt={alt} widths={[200, 400, 780]} sizes={sizes} loading={loading} />
      <span class="phone-frame__island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  /* 枠の太さや角丸を幅に比例させるため、外側をコンテナにして内側を cqi で描く */
  .phone-frame {
    container-type: inline-size;
    container-name: phone;
  }

  .phone-frame__body {
    position: relative;
    padding: 3.6cqi;
    border-radius: 15cqi;
    background-color: #1c1c1e;
    box-shadow:
      inset 0 0 0 0.9cqi #4a4a4d,
      inset 0 0 0 1.6cqi #1c1c1e,
      0 3cqi 10cqi rgb(0 0 0 / 0.3);
  }

  /* 側面のボタン(右: 電源、左: 音量) */
  .phone-frame__body::before,
  .phone-frame__body::after {
    content: "";
    position: absolute;
    inline-size: 1.2cqi;
    border-radius: 1cqi;
    background-color: #4a4a4d;
  }

  .phone-frame__body::before {
    top: 24%;
    right: -0.9cqi;
    block-size: 14%;
  }

  .phone-frame__body::after {
    top: 20%;
    left: -0.9cqi;
    block-size: 8%;
    box-shadow: 0 12cqi 0 #4a4a4d;
  }

  .phone-frame__screen {
    position: relative;
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border-radius: 11.5cqi;
    background-color: #000;
  }

  .phone-frame__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top;
  }

  .phone-frame__island {
    position: absolute;
    top: 2.6cqi;
    left: 50%;
    inline-size: 30cqi;
    block-size: 8.5cqi;
    border-radius: 999px;
    background-color: #000;
    translate: -50% 0;
  }
</style>
