---
import type { CollectionEntry } from "astro:content";
import DeviceMockup from "./DeviceMockup.astro";
import StatusBadge from "./StatusBadge.astro";
import WorkLinks from "./WorkLinks.astro";

interface Props {
  work: CollectionEntry<"works">;
  headingLevel?: 2 | 3;
  priority?: boolean;
}

const { work, headingLevel = 3, priority = false } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const titleId = `work-${work.id}-title`;
const href = `/works/${work.id}/`;
---

<article class="work-card" aria-labelledby={titleId}>
  <Heading id={titleId} class="work-card__title">
    <a class="work-card__link" href={href}>{work.data.title}</a>
  </Heading>
  <!-- タイトルと同じ行き先なので、Tabキーでは止めない -->
  <a class="work-card__media" href={href} tabindex="-1" aria-hidden="true">
    <DeviceMockup desktop={work.data.images.desktop} mobile={work.data.images.mobile} title={work.data.title} priority={priority} />
  </a>
  <div class="work-card__meta">
    <StatusBadge status={work.data.status} />
  </div>
  <p class="work-card__summary">{work.data.summary}</p>
  <ul class="work-card__tags" role="list" aria-label="使用技術">
    {work.data.tech.map(tech => <li class="work-card__tag">{tech}</li>)}
  </ul>
  {
    (work.data.links.demo || work.data.links.repo) && (
      <div class="work-card__actions">
        <WorkLinks title={work.data.title} links={work.data.links} />
      </div>
    )
  }
</article>

<style>
  .work-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: var(--space-12);
    padding: var(--space-24);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-surface);
  }

  /* DOMは見出し始まり、見た目は画像を上にする */
  .work-card__media {
    order: 0;
    display: block;
    padding-block: var(--space-8);
    border-radius: var(--radius);
  }

  .work-card__meta {
    order: 1;
  }

  .work-card__title {
    order: 2;
    font-size: 1.375rem;
    line-height: calc(32 / 22);
  }

  .work-card__summary {
    order: 3;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .work-card__tags {
    order: 4;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .work-card__tag {
    padding: var(--space-4) var(--space-8);
    border-radius: 4px;
    background-color: var(--color-bg);
    font-size: 0.75rem;
    line-height: 16px;
  }

  .work-card__actions {
    order: 5;
    padding-block-start: var(--space-4);
  }

  .work-card__link {
    text-decoration: none;
  }

  /* 画像にホバーしたときも、行き先が分かるようにタイトルへ下線を出す */
  @media (any-hover: hover) {
    .work-card__link:hover,
    .work-card:has(.work-card__media:hover) .work-card__link {
      text-decoration-line: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 2px;
    }
  }

  .work-card__link:active {
    color: var(--color-accent);
  }

  @media (width < 480px) {
    .work-card {
      padding: var(--space-16);
    }
  }
</style>
