---
import ThemeToggle from "./ThemeToggle.astro";

const NAV = [
  { href: "/#works", label: "Works" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="header">
  <div class="header__inner l-container">
    <a class="header__logo" href="/" translate="no">Shuri Amemori</a>
    <nav class="header__nav" aria-label="メイン">
      <ul class="header__list" role="list">
        {
          NAV.map(item => (
            <li>
              <a class="header__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-block-end: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: grid;
    grid-template-areas: "logo nav toggle";
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8) var(--space-16);
    min-block-size: 64px;
  }

  .header__logo {
    grid-area: logo;
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav {
    grid-area: nav;
    justify-self: end;
  }

  :global(.theme-toggle) {
    grid-area: toggle;
  }

  .header__list {
    display: flex;
    gap: var(--space-8);
  }

  .header__link {
    display: flex;
    align-items: center;
    min-block-size: var(--control-height);
    padding-inline: var(--space-8);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (any-hover: hover) {
    .header__link:hover {
      text-decoration-line: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 2px;
    }
  }

  .header__link:active {
    color: var(--color-accent);
  }

  /* スマホ幅: 1行目にロゴとトグル、2行目にメニュー。2段で高さが増えるため固定しない */
  @media (width < 480px) {
    .header {
      position: static;
    }

    .header__inner {
      grid-template-areas:
        "logo toggle"
        "nav nav";
      grid-template-columns: 1fr auto;
      gap: 0 var(--space-8);
      padding-block: var(--space-8);
    }

    .header__logo {
      font-size: 1.25rem;
    }

    .header__nav {
      justify-self: stretch;
      border-block-start: 1px solid var(--color-border);
    }

    .header__list {
      justify-content: space-between;
    }

    .header__link {
      font-size: 0.875rem;
    }
  }
</style>
