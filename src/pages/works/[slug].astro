---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DeviceMockup from "../../components/DeviceMockup.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import WorkLinks from "../../components/WorkLinks.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map(work => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const { title, summary, role, tech, links, images, status } = work.data;
const hasLinks = Boolean(links.demo || links.repo);
---

<BaseLayout title={title} description={summary}>
  <article class="work l-container" aria-labelledby="work-title">
    <nav aria-label="パンくずリスト">
      <ol role="list" class="breadcrumb">
        <li><a class="breadcrumb__link" href="/">トップ</a></li>
        <li><a class="breadcrumb__link" href="/#works">Works</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="work__header">
      <StatusBadge status={status} />
      <h1 id="work-title" class="work__title">{title}</h1>
      <p class="work__summary">{summary}</p>
      {hasLinks ? <WorkLinks title={title} links={links} /> : <p class="work__note">公開の準備中のため、デモとコードはまだ公開していません。</p>}
    </header>

    <DeviceMockup desktop={images.desktop} mobile={images.mobile} title={title} size="large" priority />

    <dl class="work__facts">
      <div class="work__fact">
        <dt>担当範囲</dt>
        <dd>{role}</dd>
      </div>
      <div class="work__fact">
        <dt>使用技術</dt>
        <dd>
          <ul class="work__tags" role="list">
            {tech.map(item => <li class="work__tag">{item}</li>)}
          </ul>
        </dd>
      </div>
    </dl>

    <p>
      <a class="button work__back" data-variant="secondary" href="/#works">
        <Icon name="arrow-right" class="button__icon work__back-icon" />
        作品一覧に戻る
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .work {
    display: grid;
    gap: var(--space-40);
    padding-block-start: var(--space-24);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-8);
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .breadcrumb > li:not(:last-child)::after {
    content: "/";
    margin-inline-start: var(--space-8);
  }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height);
  }

  .work__header {
    display: grid;
    justify-items: start;
    gap: var(--space-16);
  }

  .work__title {
    font-size: clamp(1.75rem, 1.3rem + 2svi, 2.75rem);
    line-height: calc(52 / 44);
  }

  .work__summary {
    max-inline-size: min(40em, 100%);
    color: var(--color-muted);
  }

  .work__note {
    padding: var(--space-12) var(--space-16);
    border-inline-start: 4px solid var(--color-border-strong);
    background-color: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .work__facts {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .work__fact {
    display: grid;
    grid-template-columns: 8em 1fr;
    gap: var(--space-8) var(--space-24);
    padding-block: var(--space-16);
    border-block-end: 1px solid var(--color-border);
  }

  .work__fact dt {
    font-weight: 700;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .work__tag {
    padding: var(--space-4) var(--space-8);
    border-radius: 4px;
    background-color: var(--color-surface);
    font-size: 0.875rem;
    line-height: 20px;
  }

  /* 右向きの矢印を左右反転して「戻る」に使う。ホバー時の移動(共通ボタンの transform)も反転して左へ動く */
  .work__back :global(.work__back-icon) {
    scale: -1 1;
  }

  @media (width < 640px) {
    .work__fact {
      grid-template-columns: 1fr;
    }
  }
</style>
