---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import ContactForm from "../components/ContactForm.astro";
import HeroVisual from "../components/HeroVisual.astro";
import { sortWorks } from "../lib/works";

const FORMSPREE_ENDPOINT = "https://formspree.io/f/mljjerbq";
const works = sortWorks(await getCollection("works"));

const SKILLS = [
  { name: "HTML / CSS (SCSS)", note: "FLOCSS + BEM、アクセシビリティを意識したマークアップ" },
  { name: "JavaScript", note: "GSAP・Swiper.jsを使った動きの実装" },
  { name: "PHP / WordPress", note: "オリジナルテーマ開発、ACFを使った運用設計" },
  { name: "TypeScript / React / Next.js", note: "学習中。App Routerで作品を制作中" },
  { name: "UI / UX", note: "学習中" },
  { name: "Tools", note: "Vite、Docker(@wordpress/env)、Git / GitHub" },
];
---

<BaseLayout title="Shuri Amemori Portfolio">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner l-container">
      <hgroup class="hero__heading">
        <p class="hero__eyebrow" lang="en">Portfolio</p>
        <h1 id="hero-title" class="hero__name">雨森 守浬</h1>
        <p class="hero__roman" translate="no" lang="en">Shuri Amemori</p>
        <p class="hero__role">Webフロントエンド / WordPress テーマ開発</p>
      </hgroup>
      <HeroVisual works={works} />
    </div>
  </section>

  <section id="works" class="section l-container" aria-labelledby="works-title">
    <h2 id="works-title" class="section__title">Works</h2>
    <ul class="works-list" role="list">
      {
        works.map((work, index) => (
          <li>
            <WorkCard work={work} priority={index === 0} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" class="band" aria-labelledby="about-title">
    <div class="section l-container">
      <h2 id="about-title" class="section__title">About</h2>
      <div class="about">
        <div class="about__text">
          <p>情報処理科の2年生で、2027年卒業予定です。コンピューターサイエンスを中心に学んでいます。</p>
          <p>最近は学校の授業で、自分たちで企画したアプリを開発して発表するチーム開発に取り組んでいます。現在はそのチームのリーダーとして、開発を進めています。</p>
          <p>授業の外では、WordPressのオリジナルテーマ制作を中心に作品を作ってきました。現在は UI/UX や TypeScript、React / Next.js を学習しています。</p>
        </div>
        <h3 class="about__subtitle" lang="en">Skills</h3>
        <dl class="skills">
          {
            SKILLS.map(skill => (
              <div class="skills__item">
                <dt class="skills__name" lang="en">{skill.name}</dt>
                <dd class="skills__note">{skill.note}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section id="contact" class="section l-container" aria-labelledby="contact-title">
    <h2 id="contact-title" class="section__title">Contact</h2>
    <p class="contact__lead">お問い合わせは、下記のフォームからお送りください。</p>
    <ContactForm endpoint={FORMSPREE_ENDPOINT} />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* 傾けたスマホや背景の光が画面の端からはみ出しても、横スクロールを出さない */
    overflow-x: clip;
  }

  /* 背景のドット柄。中央から外へ向かって薄くする */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in srgb, var(--color-text) 18%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 80% at 60% 45%, #000 20%, transparent 75%);
  }

  /* 左上のアクセント色の淡い光 */
  .hero::after {
    content: "";
    position: absolute;
    top: -20%;
    left: -10%;
    z-index: -1;
    inline-size: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent);
    filter: blur(40px);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    align-items: center;
    gap: 32px;
    padding-block: clamp(40px, 8svi, 96px) clamp(24px, 4svi, 48px);
  }

  .hero__heading {
    display: grid;
    gap: var(--space-8);
  }

  .hero__role {
    margin-block-start: var(--space-8);
    color: var(--color-muted);
    font-size: 1rem;
  }

  .hero__eyebrow {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  @media (width < 720px) {
    .hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }

  .hero__name {
    font-size: clamp(2.25rem, 1.5rem + 3.5svi, 4rem);
    line-height: calc(72 / 64);
    letter-spacing: 0.08em;
  }

  .hero__roman {
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.1rem + 0.7svi, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .section {
    display: grid;
    gap: 32px;
    padding-block-start: var(--space-section);
    scroll-margin-block-start: 64px;
  }

  .section__title {
    font-size: clamp(2rem, 1.5rem + 2.2svi, 3.25rem);
    line-height: calc(56 / 52);
    letter-spacing: 0.06em;
  }

  .works-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: clamp(16px, 3svi, 32px);
  }

  .works-list > li {
    display: grid;
  }

  /* 背景色を変えた全幅の帯。白一色が続かないようにする */
  .band {
    margin-block-start: var(--space-section);
    padding-block-end: var(--space-section);
    border-block: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .band > .section {
    padding-block-start: var(--space-section);
  }

  .about {
    display: grid;
    gap: 24px;
    max-inline-size: min(48em, 100%);
  }

  .about__text {
    display: grid;
    gap: 1em;
  }

  .about__subtitle {
    margin-block-start: 16px;
    font-size: 1.5rem;
  }

  .skills {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .skills__item {
    display: grid;
    grid-template-columns: minmax(10em, 1fr) 2fr;
    gap: 8px 24px;
    padding-block: 16px;
    border-block-end: 1px solid var(--color-border);
  }

  .skills__name {
    font-weight: 700;
  }

  .skills__note {
    color: var(--color-muted);
  }

  @media (width < 640px) {
    .skills__item {
      grid-template-columns: 1fr;
    }
  }
</style>
